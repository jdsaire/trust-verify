{
  "name": "yape-trust-verify",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Brief 04 — payment-confirmation trust & verification express app. Front-end only.",
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
